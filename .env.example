# ===== 后端服务地址 =====
# 服务端 HTTP 主机与端口（本地默认 38678）
VITE_API_HOST=127.0.0.1
VITE_API_PORT=38678

# 也可以直接配置完整 Base URL；配置后优先使用它
# VITE_API_BASE_URL=http://127.0.0.1:38678/api/v1

# WebSocket 主机与端口
VITE_WS_HOST=127.0.0.1
VITE_WS_PORT=1883

# 也可以直接配置完整 WebSocket 地址；配置后优先使用
# VITE_WS_URL=ws://127.0.0.1:1883

# 开发者后台地址：普通用户在客户端只能跳转，创建/删除机器人在后台完成
VITE_DEVELOPER_CONSOLE_URL=https://developer.starrysky.cn

# 请求超时（毫秒）
VITE_API_TIMEOUT=15000
